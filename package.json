{
  "name": "@ericcarco/ui-sandbox",
  "version": "0.1.0",
  "private": true,
  "description": "Independent, accessible React components for Eric's projects.",
  "type": "module",
  "files": ["dist"],
  "exports": {
    ".": {"types": "./dist/index.d.ts", "import": "./dist/ui-sandbox.js"},
    "./styles.css": "./dist/ui-sandbox.css"
  },
  "sideEffects": ["**/*.css"],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.lib.json",
    "build:demo": "vite build --config vite.demo.config.ts",
    "preview": "vite preview --config vite.demo.config.ts --host 0.0.0.0",
    "test": "playwright test"
  },
  "peerDependencies": {"react": "^18.2.0 || ^19.0.0", "react-dom": "^18.2.0 || ^19.0.0", "motion": "^12.0.0"},
  "devDependencies": {"@playwright/test": "^1.56.0", "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0", "@vitejs/plugin-react": "^5.0.0", "motion": "^12.0.0", "react": "^19.0.0", "react-dom": "^19.0.0", "typescript": "^5.9.0", "vite": "^7.0.0"}
}
